# Neon (use the POOLED connection string)
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# GEAP / Gemini policy-compiler agent. Set EITHER:
#  (a) Vertex / enterprise agent platform mode (uses Application Default Credentials)
GEAP_PROJECT=
GEAP_LOCATION=us-central1
#  (b) Gemini Developer API
GOOGLE_API_KEY=
GEAP_MODEL=gemini-2.5-flash

# PayPal (sandbox first)
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Phase 4: auth, sessions, anchoring (generate each; never commit real values) ---
# 32 random bytes, base64. Seals admin TOTP seeds. Production: load from a secret manager.
#   openssl rand -base64 32
SENTINEL_MASTER_KEY=
# >= 32 chars. Signs the read-only dashboard session cookie.   openssl rand -hex 32
SESSION_SECRET=
# >= 32 chars. Bearer secret for the anchoring cron endpoint.  openssl rand -hex 32
CRON_SECRET=
# Optional external anchor sink (object-lock bucket behind a small function). https only.
ANCHOR_SINK_URL=
ANCHOR_HMAC_KEY=
# Optional public origin used in the generated OpenAPI doc (defaults to the request origin)
PUBLIC_BASE_URL=

# Rate limits (defaults shown)
RL_VALIDATE_PER_MIN=600
RL_COMPILE_PER_HOUR=10
RL_COMPILE_PER_DAY=50
RL_ASSISTANT_PER_HOUR=30
RL_LOGIN_PER_15MIN=5

# API keys are NOT configured here any more. Create tenants and keys with:
#   npm run admin -- tenant --id acme --name "Acme" --merchant MERCHANT_ID
#   npm run admin -- key --tenant acme --role admin|agent --label "..."
